<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F4F6">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Ticimax Bağlantısı" android:textStyle="bold" android:textSize="26sp" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Bilgiler yalnızca bu telefonda saklanır." android:layout_marginTop="6dp" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/domain" android:hint="https://www.magazaniz.com" android:inputType="textUri" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/memberCode" android:hint="Ticimax Üye Kodu" android:inputType="textPassword" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/test" android:text="Bağlantıyı Test Et" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="56dp"/>
    <Button android:id="@+id/save" android:text="Kaydet" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="56dp"/>
    <TextView android:id="@+id/status" android:layout_marginTop="16dp" android:textColor="#374151" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
</ScrollView>
